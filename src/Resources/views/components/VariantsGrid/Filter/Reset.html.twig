{% props
    label = 'listing.filterPanelResetAll'|trans|sw_sanitize,
    icon = 'arrow-counter-clockwise', # vi_icon name | null
    # Button color, see Button.html.twig
    color = 'link',
    size = 'sm', # sm | md | lg
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'vi-variants-grid-filter-reset' },
}|replace_recursive(cva)) %}

<twig:ViewsTheme:Button
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        type: 'button',
        icon: icon ?: false,
        label: label,
        color: color,
        size: size,
        'data-component': 'ViewsTheme:VariantsGrid:Filter:Reset',
    }).all() }}
/>
